# Required for the NARQA EBOS web platform.
# Never commit real values. Configure production values in the deployment secret manager.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=

# Required only for server-side AI visual/text analysis routes.
# These values must never be exposed to the mobile or web client.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# WhatsApp Business stays not_configured unless official Meta credentials,
# consent/retention rules, webhook verification, and signature validation are supplied.
# Do not add provider credentials to mobile app.json or source control.
