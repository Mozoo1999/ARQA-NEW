{
  "expo": {
    "name": "NARQA EBOS",
    "slug": "narqa-ebos",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "narqa-ebos",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.narqa.ebos",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستخدم NARQA EBOS الميكروفون لاستقبال الأوامر الصوتية بعد إذن المستخدم.",
        "NSSpeechRecognitionUsageDescription": "يستخدم NARQA EBOS التعرف على الكلام لتحويل الأوامر العربية إلى نص قابل للمراجعة.",
        "NSCameraUsageDescription": "يستخدم NARQA EBOS الكاميرا لالتقاط الإيصالات والمستندات لمراجعتها.",
        "NSPhotoLibraryUsageDescription": "يستخدم NARQA EBOS مكتبة الصور لاختيار مستندات الإدخال.",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.narqa.ebos",
      "permissions": ["RECORD_AUDIO", "CAMERA", "READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "اسمح لـ $(PRODUCT_NAME) باستخدام الميكروفون لاستقبال الأوامر الصوتية.",
          "speechRecognitionPermission": "اسمح لـ $(PRODUCT_NAME) بتحويل الأوامر الصوتية إلى نص للمراجعة.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "voice_shortcut": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundColor": "#07111F"
            }
          },
          "iosIcons": {
            "voice_shortcut": "./assets/android-icon-foreground.png"
          },
          "iosActions": [
            {
              "id": "start-voice-command",
              "title": "بدء أمر صوتي",
              "subtitle": "استماع وتحليل بالعربية",
              "icon": "voice_shortcut",
              "params": { "action": "voice" }
            }
          ]
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://narqaebos-c2nmdy4n.manus.space"
    }
  }
}
